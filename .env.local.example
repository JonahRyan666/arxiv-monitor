FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
# Production should use OpenRouter. This value is the full chat-completions URL.
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENAI_COMPAT_URL is an alias of LLM_BASE_URL, used only when LLM_BASE_URL is unset.
OPENROUTER_API_KEY=
# Optional backup. Preferred only when LLM_BASE_URL points at SiliconFlow.
SILICONFLOW_API_KEY=
# Defaults match config.yaml. Unset these to use the file.
# LLM_SCREEN_MODEL=google/gemma-4-31b-it:free
# LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
# LLM_TRANSLATE_MODEL=google/gemma-4-26b-a4b-it:free
# Aliases, used only when the LLM_* name above is unset:
# SILICONFLOW_SCREEN_MODEL=
# SILICONFLOW_FALLBACK_MODEL=
# SILICONFLOW_MODEL=
MAX_PAPERS_PER_RUN=12
JPSJ_TARGET_PER_RUN=8
JPSJ_BROWSER_COOKIE_FETCH=1
CROSSREF_TIMEOUT=30
CROSSREF_RETRIES=2
CROSSREF_QUERY_DELAY=2
CROSSREF_RETRY_BASE_DELAY=10
LLM_TIMEOUT=120
# SILICONFLOW_TIMEOUT is an alias of LLM_TIMEOUT.
SILICONFLOW_RETRIES=0
ARXIV_TIMEOUT=35
ARXIV_RETRIES=3
ARXIV_QUERY_DELAY=4
ARXIV_RETRY_BASE_DELAY=10
